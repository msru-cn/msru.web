# GitHub 分支（文档 "编辑此页" 链接用）
GITHUB_BRANCH=master

# Dify 云服务（站内 AI 问答后端）
DIFY_API_KEY=your-dify-app-key-here
DIFY_BASE_URL=https://api.dify.ai/v1

# ── P2 内容运行时化 ──────────────────────────────
# 远程 MDX 内容仓库（owner/repo），文档从 raw.githubusercontent.com 拉取并 ISR 缓存
CONTENT_REPO=owner/repo
CONTENT_BRANCH=main

# SQLite 结构化内容库（营销产品数据），首次启动自动建表+seed
DATABASE_PATH=./data/msru-web.db

# revalidate webhook 密钥：内容仓库/数据库更新后 POST /api/revalidate 触发按标签失效（无需 build）
# 请求头 x-revalidate-secret 需与此值一致
REVALIDATE_SECRET=change-me-to-a-long-random-string

# ── P3 Generative UI ────────────────────────────
# DashScope（阿里云百炼）OpenAI 兼容模式，专属部署 endpoint
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
GENUI_MODEL=qwen3-max
